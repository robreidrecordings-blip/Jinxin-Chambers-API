# Jingin Chambers API — Environment Variables
# Rename this file to .env

# API authentication key (make this long and random)
API_KEY=your_secret_api_key_here

# WooCommerce — UK site
WC_UK_URL=https://yoursite.co.uk
WC_UK_KEY=ck_your_consumer_key
WC_UK_SECRET=cs_your_consumer_secret

# WooCommerce — COM site
WC_COM_URL=https://yoursite.com
WC_COM_KEY=ck_your_consumer_key
WC_COM_SECRET=cs_your_consumer_secret

# WooCommerce — NET site
WC_NET_URL=https://yoursite.net
WC_NET_KEY=ck_your_consumer_key
WC_NET_SECRET=cs_your_consumer_secret

# Server port
PORT=4000
